pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scmGit(
                    branches: [[name: '*/master']],
                    extensions: [],
                    userRemoteConfigs: [[
                        url: 'https://github.com/opstree/spring3hibernate.git'
                    ]]
                )
            }
        }

        stage('Compile') {
            steps {
                sh 'mvn clean compile -Dmaven.compiler.source=1.8 -Dmaven.compiler.target=1.8'
            }
        }

        stage('Gitleaks Scan') {
            steps {
                sh 'gitleaks detect --source . --no-git --report-format json --report-path gitleaks-report.json'
            }
        }

        stage('Archive Gitleaks Report') {
            steps {
                archiveArtifacts artifacts: 'gitleaks-report.json', fingerprint: true
            }
        }

        stage('Parallel Execution') {
            parallel {
                stage('Unit Test') {
                    steps {
                        sh 'mvn test -Dmaven.compiler.source=1.8 -Dmaven.compiler.target=1.8'
                    }
                }

                stage('OWASP Dependency Check') {
                    steps {
                        dependencyCheck(
                            additionalArguments: '--scan ./ --nvdApiKey 9AB9703D-0853-4589-AC55-64AAC3CCD685',
                            odcInstallation: 'Dependency-Check'
                        )

                        dependencyCheckPublisher(
                            pattern: '**/dependency-check-report.xml'
                        )
                    }
                }
            }
        }

        stage('Package') {
            input {
                message "Kya Package stage run karna hai?"
                ok "Proceed (Run Package)"
            }
            steps {
                sh 'mvn package -DskipTests -Dmaven.compiler.source=1.8 -Dmaven.compiler.target=1.8'
                archiveArtifacts artifacts: 'target/*.war, target/*.jar', allowEmptyArchive: true
            }
        }

        stage('Create Release Tag') {
            when {
                anyOf {
                    branch 'master'
                    expression { env.GIT_BRANCH == 'origin/master' }
                }
            }
            steps {
                sh '''
                    git config user.name "Jenkins CI"
                    git config user.email "jenkins@ci.local"
                    
                    TAG_NAME="v1.0.${BUILD_NUMBER}"
                    echo "Creating tag: ${TAG_NAME}"
                    
                    git tag -a "${TAG_NAME}" -m "Release tag generated by Jenkins build #${BUILD_NUMBER}"
                '''
            }
        }
    }
}
