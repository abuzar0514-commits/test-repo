pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scmGit(
                    branches: [[name: '*/master']], 
                    extensions: [], 
                    userRemoteConfigs: [[url: 'https://github.com/opstree/spring3hibernate.git']]
                )
            }
        }

        stage('Compile') {
            steps {
                sh 'mvn clean compile'
            }
        }

        stage('Git Leaks') {
            steps {
                sh 'gitleaks detect --source . --verbose --report-path gitleaks-report.json || true'
            }
        }

        stage('Archive Artifacts') {
            steps {
                archiveArtifacts artifacts: 'gitleaks-report.json', allowEmptyArchive: true, fingerprint: true
            }
        }

        stage('Parallel') {
            parallel {
                stage('Unit Tests') {
                    steps {
                        sh 'mvn test'
                    }
                }

                stage('OWASP Dependency Check') {
                    steps {
                        sh 'mvn org.owasp:dependency-check-maven:check -Dformat=JSON -Dout=owasp-report.json || true'
                    }
                }
            }
        }

        stage('Package') {
            input {
                message "Do you want to proceed with building the WAR package?"
                ok "Proceed"
            }
            steps {
                sh 'mvn package -DskipTests'
                archiveArtifacts artifacts: 'target/*.war', allowEmptyArchive: false, fingerprint: true
            }
        }

        stage('Create Release Tag') {
            when {
                anyOf {
                    branch 'master'
                    expression { env.GIT_BRANCH == 'origin/master' }
                }
            }
            steps {
                sh '''
                    git config user.name "Jenkins CI"
                    git config user.email "jenkins@ci.local"
                    
                    TAG_NAME="v1.0.${BUILD_NUMBER}"
                    echo "Creating tag: ${TAG_NAME}"
                    
                    git tag -a "${TAG_NAME}" -m "Release tag generated by Jenkins build #${BUILD_NUMBER}"
                '''
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true, testResults: '**/target/surefire-reports/*.xml'
            archiveArtifacts artifacts: 'owasp-report.json', allowEmptyArchive: true, fingerprint: true
        }
    }
}
